{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sharebuff",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "../web",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "SECRET", "class_name": "Secret" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Secret"] }],
  "observability": { "enabled": false }
}
